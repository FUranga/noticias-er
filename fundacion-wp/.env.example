# Copia este archivo a ".env" (sin ".example") y completa con tus datos reales.
# ".env" nunca se sube al repo (ver .gitignore).
# Application Password generada en desarrolloentrerriano.org/wp-admin -> Usuarios -> Perfil -> Application Passwords
# (NO es la contraseña real de la cuenta).

FUNDER_WP_URL=https://desarrolloentrerriano.org
FUNDER_WP_USER=tu-email-o-usuario-de-wordpress
FUNDER_WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
